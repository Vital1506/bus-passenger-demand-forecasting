# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
BUS_FORECAST_ALLOW_PUBLIC_AI=true

# Security & Role-Based Access Control (RBAC)
# Set BUS_FORECAST_DEV_MODE=1 for unauthenticated local development.
# In production, default fails closed (public role for unauthenticated requests).
BUS_FORECAST_DEV_MODE=0
BUS_FORECAST_REQUIRE_AUTH=false

# RBAC Keys (Discrete)
BUS_FORECAST_ADMIN_KEY=your_admin_secret_key_here
BUS_FORECAST_OPERATOR_KEY=your_operator_secret_key_here
BUS_FORECAST_OPERATOR_AGENCY=CTA
BUS_FORECAST_ANALYST_KEY=your_analyst_secret_key_here
BUS_FORECAST_ANALYST_AGENCY=CTA

# Legacy Unified API Key (backward compatible; grants Operator role)
BUS_FORECAST_API_KEY=

# Multi-key JSON Configuration (Alternative for multi-tenant deployments)
# BUS_FORECAST_API_KEYS_JSON=[{"key": "secret123", "role": "operator", "agency": "CTA", "key_id": "cta_op_1"}]

# Webhook SSRF Allowlist (Comma-separated hostnames allowed for operational alerts)
# BUS_FORECAST_WEBHOOK_ALLOWLIST=hooks.slack.com,api.pagerduty.com

# Storage & Database (Optional)
BUS_FORECAST_DATA_DIR=data
# DATABASE_URL=postgresql://user:pass@localhost:5432/bus_forecast
# REDIS_URL=redis://localhost:6379/0
